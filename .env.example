# Секреты не пишем сюда: только ссылку {{secret:scope/NAME}}.
# Значение — в ~/.secrets/<scope>/<NAME> (права 600): tgvault secret set TG_API_HASH
# tgvault подставляет значение при старте; в логах и в -h видно только ссылку.
TG_API_ID={{secret:tgvault/TG_API_ID}}
TG_API_HASH={{secret:tgvault/TG_API_HASH}}
GEMINI_API_KEY={{secret:tgvault/GEMINI_API_KEY}}

# Не секреты — можно писать значениями (setup заполняет сам):
# WHISPER_MODEL=
# FFMPEG=
